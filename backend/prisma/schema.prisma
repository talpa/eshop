generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum DeliveryType {
  HOME
  PACKETA
}

model MilitaryUnit {
  id            String    @id @default(cuid())
  name          String
  nameEn        String?
  nameUk        String?
  nameDe        String?
  slug          String    @unique
  description   String?
  descriptionEn String?
  descriptionUk String?
  descriptionDe String?
  logo          String?
  youtubeUrls   String[]
  photos        String[]
  activityId    String?
  activity    Activity?    @relation(fields: [activityId], references: [id])
  isActive    Boolean      @default(true)
  orders      Order[]
  products    Product[]    @relation("ProductMilitaryUnits")
  updates     UnitUpdate[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model UnitUpdate {
  id             String       @id @default(cuid())
  militaryUnitId String
  militaryUnit   MilitaryUnit @relation(fields: [militaryUnitId], references: [id])
  title          String
  titleEn        String?
  titleUk        String?
  titleDe        String?
  content        String
  contentEn      String?
  contentUk      String?
  contentDe      String?
  sentAt         DateTime     @default(now())
  recipientCount Int          @default(0)
  createdAt      DateTime     @default(now())
}

model Activity {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  nameEn        String?
  nameUk        String?
  nameDe        String?
  isActive      Boolean       @default(true)
  militaryUnits MilitaryUnit[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  name              String
  passwordHash      String?
  phone             String?
  preferredLanguage String?
  bankAccountNumber String?
  provider          String?
  providerId        String?
  avatarUrl         String?
  role              UserRole      @default(CUSTOMER)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  orders            Order[]
  addresses         UserAddress[]
}

model UserAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  street    String
  city      String
  zip       String
  country   String   @default("CZ")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id            String     @id @default(cuid())
  name          String
  nameEn        String?
  nameUk        String?
  nameDe        String?
  slug          String     @unique
  description   String?
  descriptionEn String?
  descriptionUk String?
  descriptionDe String?
  sortOrder   Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  products    Product[]
  createdAt   DateTime   @default(now())
}

model Product {
  id            String         @id @default(cuid())
  name          String
  nameEn        String?
  nameUk        String?
  nameDe        String?
  slug          String         @unique
  description   String?
  descriptionEn String?
  descriptionUk String?
  descriptionDe String?
  priceCzk      Decimal        @db.Decimal(10, 2)
  stock         Int            @default(0)
  images        String[]
  sortOrder     Int            @default(0)
  isActive      Boolean        @default(true)
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  militaryUnits MilitaryUnit[] @relation("ProductMilitaryUnits")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Order {
  id                  String        @id @default(cuid())
  userId              String?
  user                User?         @relation(fields: [userId], references: [id])
  militaryUnitId      String?
  militaryUnit        MilitaryUnit? @relation(fields: [militaryUnitId], references: [id])
  status              OrderStatus   @default(PENDING)
  totalCzk            Decimal       @db.Decimal(10, 2)
  donationAmount      Decimal       @db.Decimal(10, 2)
  variableSymbol      String        @unique
  customerName        String
  customerEmail       String
  shippingAddress     String?
  street              String?
  city                String?
  zip                 String?
  country             String        @default("CZ")
  deliveryType        DeliveryType  @default(HOME)
  packetaPointId      String?
  packetaPointName    String?
  note                String?
  isAnonymous         Boolean       @default(false)
  activityCode        String?
  activityName        String?
  paymentNote         String?
  fundsUsed           Boolean       @default(false)
  confirmationSentAt  DateTime?
  items               OrderItem[]
  payment             Payment?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Int
  unitPriceCzk Decimal  @db.Decimal(10, 2)
  productName  String
  createdAt    DateTime @default(now())
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String        @unique
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCzk        Decimal       @db.Decimal(10, 2)
  status           PaymentStatus @default(PENDING)
  qrPayload        String
  fioTransactionId String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}
